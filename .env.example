# Octalve Vault — copy to .env for local Prisma/CLI work. Never commit real values.
# In Vercel, configure these through Project Settings > Environment Variables.

# Application URLs
APP_URL=https://vault.octalve.com
NEXT_PUBLIC_APP_URL=https://vault.octalve.com
NEXT_PUBLIC_DOWNLOADS_URL=https://downloads.octalve.com
NEXT_PUBLIC_SUPPORT_EMAIL=

# PostgreSQL
DATABASE_URL=

# Session / token / anti-abuse secrets (generate independent random values, 32+ bytes each)
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=
DOWNLOAD_TICKET_SECRET=
OTP_SECRET=
RATE_LIMIT_SECRET=
REQUEST_FINGERPRINT_SECRET=
INTERNAL_DOWNLOAD_SECRET=
INTERNAL_CRON_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (bucket-scoped credentials only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=octalve-vault-assets

# Transactional email (Resend HTTP API)
RESEND_API_KEY=
EMAIL_FROM=

# Payment providers. Enable only providers whose LIVE credentials/account capabilities are configured.
PAYMENT_PROVIDER_PAYSTACK_ENABLED=false
PAYSTACK_ENVIRONMENT=TEST
PAYSTACK_ENABLED_CURRENCIES=NGN
PAYSTACK_SECRET_KEY=

PAYMENT_PROVIDER_FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_ENVIRONMENT=TEST
FLUTTERWAVE_ENABLED_CURRENCIES=NGN
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# One-time bootstrap only. Set locally, run `pnpm admin:bootstrap`, then remove these values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
